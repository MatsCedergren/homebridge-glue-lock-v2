{
  "displayName": "Glue Lock (Homebridge v2)",
  "name": "homebridge-glue-lock-v2",
  "version": "1.0.0",
  "description": "Unofficial Homebridge plugin for Glue smart locks (fork of the GlueHome plugin). Supports Homebridge 1.8+ and 2.x.",
  "author": {
    "name": "Mats Cedergren"
  },
  "contributors": [
    "GlueHome (original author)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatsCedergren/homebridge-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/MatsCedergren/homebridge-plugin/issues"
  },
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "rimraf ./dist && tsc",
    "test": "vitest run",
    "watch": "npm run build && npm link && nodemon",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "glue",
    "glue-lock",
    "smartlock",
    "lock",
    "homekit"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@homebridge/hap-nodejs": "^2.2.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/MatsCedergren/homebridge-plugin#readme",
  "publishConfig": {
    "access": "public"
  }
}
